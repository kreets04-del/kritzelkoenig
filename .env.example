# Kritzelkönig – Beispiel-Umgebungsvariablen
# Kopiere diese Datei nach ".env" und passe die Werte an.
# WICHTIG: Niemals geheime Schlüssel im Frontend-Code speichern.
# Der Server liest optionale Werte via process.env.

# Port (Render setzt diesen automatisch; lokal Standard 3000)
PORT=3000

# Rundenanzahl-Standard und Grenzen
DEFAULT_ROUNDS=10
MAX_PLAYERS=8

# Raum-Lebensdauer (Minuten) – abgelaufene Räume werden bereinigt
ROOM_TTL_MINUTES=120

# Rate-Limits (Schutz vor Missbrauch)
MAX_ROOMS_PER_IP=20
MAX_ACTIONS_PER_MINUTE=600

# Erlaubte Ursprünge für die Einbettung (kommagetrennt).
# Für CrazyGames später die offiziellen CrazyGames-Domains ergänzen.
# Beispiel: https://www.crazygames.com,https://games.crazygames.com
ALLOWED_ORIGINS=*

# Optionale zusätzliche Online-Begriffe (true/false) – siehe server.js --online
LOAD_ONLINE=false

# Y8-Upload-Build (oeffentliche Kennungen, keine Secrets)
Y8_GAME_ID=278345
# Im Portal derzeit "Not yet available"; fuer Werbung nicht erforderlich:
# Y8_APP_ID=
# Y8_API_BASE=https://kritzelkoenig.onrender.com

# ---------------------------------------------------------------
# NUR FRONTEND / ÖFFENTLICH (kein Secret!):
# Die CrazyGames-SDK-Einbindung benötigt KEINEN geheimen Key im Code.
# Der App-Identifier wird von CrazyGames beim Hochladen zugeordnet.
# ---------------------------------------------------------------
